pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                sh 'echo "Hello from MacBook!"'
                sh 'aws --version || echo "no aws cli installed"'
                sh 'ps -ef | head -20'
            }
        }
    }

    // Optional: nice console colors and timestamps
    options {
        timestamps()
        ansiColor('xterm')
    }
}